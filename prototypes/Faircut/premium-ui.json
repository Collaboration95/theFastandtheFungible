{
  "profile": "product-admin",
  "sourceRoots": ["src", "server"],
  "locale": "en-SG",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Scrollbar", "Toast"],
  "ownership": { "Scrollbar": "runtime-css", "Toast": "shared-live-region", "Drawer": "authored-modal" },
  "requiredCommands": ["unit", "build", "premium"],
  "commands": {
    "unit": "npm run test:unit",
    "build": "npm run build",
    "premium": "npm run verify:premium"
  },
  "evidence": {
    "failurePaths": "tests/domain.test.ts",
    "browserWorkflow": "tests/e2e.spec.ts"
  }
}
