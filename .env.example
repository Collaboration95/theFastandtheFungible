# Copy to .env. Everything is optional: `make run` works with no .env at all.
# `make doctor` flags vars in .env that nothing reads; `make keys` tests the provider keys.

# --- Live providers (only `make live` / npm run demo:live uses these) ---
# demo:live writes answers and reports with DeepSeek (platform.deepseek.com).
DEEPSEEK_API_KEY=
# Empty = deepseek-flash. (deepseek-v4-pro is the larger option.)
DEEPSEEK_MODEL=
# Optional endpoint override; empty = https://api.deepseek.com
DEEPSEEK_BASE_URL=
LLM_TIMEOUT_MS=30000
# Groq is still supported when running processes by hand with LLM_PROVIDER=groq:
# GROQ_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
CLOUDFLARE_API_TOKEN=
# Empty = resolved once from the token (it must see exactly one account).
CLOUDFLARE_ACCOUNT_ID=
# @cf/cloudflare/clef-flash (default) or @cf/cloudflare/clef
DECISION_MODEL=@cf/cloudflare/clef-flash
# Empty = per-model default: 0.15 clef-flash, 0.35 clef, 0.20 fixture.
BUY_THRESHOLD=

# --- XRPL Testnet settlement (make live pays on the Testnet when a seed is set) ---
# Testnet only: the rail refuses any host outside *.rippletest.net. Testnet XRP has no value.
XRPL_PAYER_SEED=
# Optional; doctor checks it matches the seed.
XRPL_PAYER_ADDRESS=
# Empty = the one funded demo receiver every simulated publisher uses for now (#98).
XRPL_RECEIVER_ADDRESS=
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
# simulated | xrpl-testnet. Empty = demo picks (live + seed → xrpl-testnet).
SETTLEMENT_RAIL=
# Publisher wallets (#98 phase 2). Addresses are public and live in data/corpus; the app never
# needs these seeds. Keep them so `make wallets` can re-fund the same addresses after a Testnet reset.
# XRPL_PUBLISHER_NORTHSTAR_WIRE_ADDRESS=
# XRPL_PUBLISHER_NORTHSTAR_WIRE_SEED=
# XRPL_PUBLISHER_CIRCUIT_NOTE_ADDRESS=
# XRPL_PUBLISHER_CIRCUIT_NOTE_SEED=
# XRPL_PUBLISHER_GRID_OPERATORS_REPORT_ADDRESS=
# XRPL_PUBLISHER_GRID_OPERATORS_REPORT_SEED=
# XRPL_PUBLISHER_GRIDSCOPE_ASIA_ADDRESS=
# XRPL_PUBLISHER_GRIDSCOPE_ASIA_SEED=
# XRPL_PUBLISHER_FIFTH_PUBLISHER_ADDRESS=
# XRPL_PUBLISHER_FIFTH_PUBLISHER_SEED=

# --- Langfuse Cloud tracing (live runs; free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://us.cloud.langfuse.com or https://cloud.langfuse.com (EU)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Empty = demo picks (live → 1, fixture/tests → 0).
LANGFUSE_ENABLED=
LANGFUSE_TRACING_ENVIRONMENT=

# --- Demo knobs ---
# open-sufficient | contradiction | unchanged | injection; empty = canonical corpus.
CORPUS_VARIANT=
# 1 enables the local "fail next delivery" toggle.
PUBLISHER_FAULTS=0
# Shift web/api/publisher ports (100 → 5200/8888/8890) to run a worktree beside main.
DEMO_PORT_OFFSET=0

# --- Set by scripts/demo.mjs; only needed when running processes by hand ---
# fixture | deepseek | groq
LLM_PROVIDER=fixture
DECISION_PROVIDER=fixture
HOST=127.0.0.1
PORT=8788
PUBLISHER_PORT=8790
# Point at a deployed publisher (Cloud Run); secret must match it. Local default otherwise.
PUBLISHER_URL=http://127.0.0.1:8790
PUBLISHER_SECRET=

# --- Storage ---
APP_DB=data/app.db
PUBLISHER_DB=data/publisher.db
REPORT_DIR=data/reports
