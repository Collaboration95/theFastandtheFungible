# Copy to .env. Everything is optional: `make run` works with no .env at all.
# `make doctor` flags vars in .env that nothing reads; `make keys` tests the provider keys.

# --- Live providers (only `make live` / npm run demo:live uses these) ---
# demo:live writes answers and reports with DeepSeek (platform.deepseek.com).
# These configure whichever LLM_PROVIDER is active (make live forces deepseek).
# Empty = https://api.deepseek.com (Groq: https://api.groq.com/openai/v1)
LLM_BASE_URL=
# Empty = deepseek-flash (deepseek-v4-pro is the larger option; Groq: llama-3.3-70b-versatile)
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
# Legacy key names, read only when LLM_API_KEY is empty:
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
# Recommended for live runs (make live, make preflight): set it so no account lookup runs at
# boot. Empty = resolved from the token on first use (it must see exactly one account); a
# failed lookup is retried on the next call.
CLOUDFLARE_ACCOUNT_ID=
# Backup Cloudflare pair (a separate account). `CF_BACKUP=1 make live` maps these onto the
# two variables above for that process; `make preflight` checks the pair answers.
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_2=
# The purchase-decision model in make live (#214, amends D9): the LLM names the gap, a decision model judges value,
# policy code pays.
#   openai     = OpenAI Decisions (gpt-6-luna), one batched request per round; needs OPENAI_API_KEY.
#   cloudflare = Cloudflare Clef-flash, one call per candidate. Empty or any other value = cloudflare.
# Revert to Clef with one line: DECISION_PROVIDER=cloudflare. make run (fixture demo) ignores it.
DECISION_PROVIDER=
OPENAI_API_KEY=
# Live decision per-attempt timeout (ms), 2 attempts. Empty = 5000. DECISION_TIMEOUT_MS overrides it for OpenAI Decisions.
CLEF_TIMEOUT_MS=
DECISION_TIMEOUT_MS=
# Questions per OpenAI Decisions request (1 gap + 3 per candidate). Empty = 19, the largest batch the benchmark measured;
# more candidates split into parallel requests.
DECISIONS_MAX_QUESTIONS=
# Clef: @cf/cloudflare/clef-flash (default) or @cf/cloudflare/clef. OpenAI Decisions: gpt-6-luna (default).
# A @cf/ model applies to Clef only, so switching DECISION_PROVIDER never sends a Clef model name to OpenAI.
DECISION_MODEL=@cf/cloudflare/clef-flash
# Empty = per-model raw default: 0.15 clef-flash, 0.35 clef, 0.20 gpt-6-luna, 0.20 fixture.
# Applies to whichever provider runs: leave it empty when switching providers.
BUY_THRESHOLD=

# --- XRPL Testnet settlement (make live pays on the Testnet when a seed is set) ---
# Testnet only: the rail refuses any host outside *.rippletest.net. Testnet XRP has no value.
XRPL_PAYER_SEED=
# Optional; doctor checks it matches the seed.
XRPL_PAYER_ADDRESS=
# Empty = the one funded demo receiver every simulated publisher uses for now (#98).
XRPL_RECEIVER_ADDRESS=
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
# simulated | xrpl-testnet. Empty = demo picks (live + seed → xrpl-testnet).
SETTLEMENT_RAIL=
# Paid publisher wallets (#133): one per paid roster publisher. `make wallets CREATE=1` fills these
# (seed + address) and funds them from the Testnet faucet; the publisher signs manifests and refunds
# with its seed on the xrpl-testnet rail. Never commit or log a seed.
XRPL_PUBLISHER_ALPHALEAK_SEED=
XRPL_PUBLISHER_ALPHALEAK_ADDRESS=
XRPL_PUBLISHER_BASIS_POINTS_SEED=
XRPL_PUBLISHER_BASIS_POINTS_ADDRESS=
XRPL_PUBLISHER_KOPI_CONTRARIAN_SEED=
XRPL_PUBLISHER_KOPI_CONTRARIAN_ADDRESS=
XRPL_PUBLISHER_LOAD_FACTOR_SEED=
XRPL_PUBLISHER_LOAD_FACTOR_ADDRESS=
XRPL_PUBLISHER_MARKETPULSE_DIGEST_SEED=
XRPL_PUBLISHER_MARKETPULSE_DIGEST_ADDRESS=
XRPL_PUBLISHER_NOTFINANCIALTIMES_SEED=
XRPL_PUBLISHER_NOTFINANCIALTIMES_ADDRESS=
XRPL_PUBLISHER_THE_FAB_FLOOR_SEED=
XRPL_PUBLISHER_THE_FAB_FLOOR_ADDRESS=

# --- Langfuse Cloud tracing (live runs; free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://us.cloud.langfuse.com or https://cloud.langfuse.com (EU)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Empty = demo picks (live → 1, fixture/tests → 0).
LANGFUSE_ENABLED=
LANGFUSE_TRACING_ENVIRONMENT=
# 1 = traces are public links (stage backups that open without a login). They include the
# passages sent to the LLM, which can be purchased evidence: use only with the synthetic corpus.
LANGFUSE_PUBLIC_TRACES=

# --- Demo knobs ---
# 1 enables the local "fail next delivery" toggle.
PUBLISHER_FAULTS=0
# Shift web/api/publisher ports (100 → 5200/8888/8890) to run a worktree beside main.
DEMO_PORT_OFFSET=0

# --- Set by scripts/demo.mjs; only needed when running processes by hand ---
# fixture | deepseek | groq
LLM_PROVIDER=fixture
HOST=127.0.0.1
PORT=8788
PUBLISHER_PORT=8790
# Point at a deployed publisher (Cloud Run); secret must match it. Local default otherwise.
PUBLISHER_URL=http://127.0.0.1:8790
PUBLISHER_SECRET=

# --- Storage ---
APP_DB=data/app.db
PUBLISHER_DB=data/publisher.db
REPORT_DIR=data/reports
