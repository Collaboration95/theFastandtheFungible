# Copy to .env. Everything is optional: `make run` works with no .env at all.
# `make doctor` flags vars in .env that nothing reads; `make keys` tests the provider keys.

# --- Live providers (only `make live` / npm run demo:live uses these) ---
GROQ_API_KEY=
# Model used in W3-LIVE qualification. Code default if empty: llama-3.3-70b-versatile.
LLM_MODEL=openai/gpt-oss-20b
# Optional OpenAI-compatible endpoint; empty = Groq.
LLM_BASE_URL=
LLM_TIMEOUT_MS=30000
CLOUDFLARE_API_TOKEN=
# Empty = resolved once from the token (it must see exactly one account).
CLOUDFLARE_ACCOUNT_ID=
# @cf/cloudflare/clef-flash (default) or @cf/cloudflare/clef
DECISION_MODEL=@cf/cloudflare/clef-flash
# Empty = per-model default: 0.15 clef-flash, 0.35 clef, 0.20 fixture.
BUY_THRESHOLD=

# --- Demo knobs ---
# open-sufficient | contradiction | unchanged | injection; empty = canonical corpus.
CORPUS_VARIANT=
# 1 enables the local "fail next delivery" toggle.
PUBLISHER_FAULTS=0
# Shift web/api/publisher ports (100 → 5200/8888/8890) to run a worktree beside main.
DEMO_PORT_OFFSET=0

# --- Set by scripts/demo.mjs; only needed when running processes by hand ---
LLM_PROVIDER=fixture
DECISION_PROVIDER=fixture
HOST=127.0.0.1
PORT=8788
PUBLISHER_PORT=8790
# Point at a deployed publisher (Cloud Run); secret must match it. Local default otherwise.
PUBLISHER_URL=http://127.0.0.1:8790
PUBLISHER_SECRET=

# --- Storage ---
APP_DB=data/app.db
PUBLISHER_DB=data/publisher.db
REPORT_DIR=data/reports
