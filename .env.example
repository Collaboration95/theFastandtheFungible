APP_MODE=fixture
PORT=8788
PUBLIC_APP_URL=http://localhost:5100
DATABASE_URL=file:./data/research-agent.db
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_SYNTHESIS_TEMPERATURE=0.85
OPENAI_API_KEY=
GROQ_API_KEY=
# Decision agent (layer 2): cloudflare | fixture (fixture runs offline).
DECISION_PROVIDER=fixture
DECISION_MODEL=@cf/cloudflare/clef-flash
# Optional; resolved from the token via GET /client/v4/accounts when empty.
CLOUDFLARE_ACCOUNT_ID=
PUBLISHER_URL=http://127.0.0.1:8790
SEMANTIC_RANKER=precomputed
TRANSFORMER_MODEL=Xenova/all-MiniLM-L6-v2
LIVE_SOURCE_ADAPTERS=none
# Keep fixture mode for the default demo. Set XRPL_MODE=live only for an
# explicitly authorized XRPL Testnet run. Never commit a seed here.
XRPL_MODE=fixture
XRPL_NETWORK=testnet
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
# Configure XRPL_PAYER_SEED only in an ignored local .env; it is intentionally
# omitted from this example and must never be copied to browser-facing config.
XRPL_PAYER_ADDRESS=
XRPL_RECEIVER_ADDRESS=
XRPL_EXPLORER_URL=https://testnet.xrpl.org/transactions
CLOUDFLARE_API_TOKEN=