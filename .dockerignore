# Publisher build allowlist: no .env, keys, databases, reports or buyer code.
**
!package.json
!package-lock.json
!publisher/
!publisher/**
!shared/
!shared/contracts/
!shared/contracts/**
!shared/xrpl.ts
!data/
!data/corpus/
!data/corpus/**
!Dockerfile.publisher
!.dockerignore
**/.env*
**/*.pem
**/*.key
**/*.db*
**/node_modules
