# Build allowlist: no .env, keys, databases or reports. Dockerfile.publisher copies only publisher code;
# the root Dockerfile (whole app for Cloud Run) also needs the web and API sources.
**
!package.json
!package-lock.json
!publisher/
!publisher/**
!shared/
!shared/contracts/
!shared/contracts/**
!shared/xrpl.ts
!data/
!data/corpus/
!data/corpus/**
!Dockerfile.publisher
!Dockerfile
!index.html
!tsconfig*.json
!vite.config.ts
!src/
!src/**
!server/
!server/**
!scripts/
!scripts/cloudrun.mjs
!.dockerignore
**/.env*
**/*.pem
**/*.key
**/*.db*
**/node_modules
