# Public configuration only. Secrets are appended from pinned Secret Manager versions.
# HG owns policy limits; see docs/hosted-web.md#gateway-configuration-hg.
HOSTED=1
HOSTED_ORIGIN=https://REPLACE.run.app
HOSTED_ADMISSIONS_UNTIL=2026-11-19T16:00:00Z
HOSTED_CONTROL_PATH=/state/control.json
HOSTED_QUESTION_CAP_MINOR=200
# Other question/session/IP/global/model/queue limits are enforced code constants.
# The API supervisor is the directly connected trusted forwarder.
HOSTED_TRUSTED_PROXY=127.0.0.1
# Fail closed until actual provider access and conservative peak prices are qualified.
HOSTED_PROVIDERS_READY_UNTIL=1970-01-01T00:00:00Z
HOSTED_RESEARCH_INPUT_USD_PER_MILLION=0
HOSTED_RESEARCH_OUTPUT_USD_PER_MILLION=0
HOSTED_DECISION_INPUT_USD_PER_MILLION=0
HOSTED_DECISION_OUTPUT_USD_PER_MILLION=0
HOSTED_DECISION_OUTPUT_TOKENS=8192
ACTIVE_WORK_LIMIT=2
LLM_PROVIDER=deepseek
DECISION_PROVIDER=openai
DECISION_MODEL=gpt-6-luna
SEARCH_EMBEDDINGS=off
SETTLEMENT_RAIL=xrpl-testnet
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
ANCHOR_RAIL=xrpl-testnet
ESCROW_MODE=key-reveal
PUBLISHER_FAULTS=0
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_TRACES=0

# Set 0 and recreate the API container to revert per-frame SSE gzip. Never use nginx gzip for SSE.
HOSTED_SSE_GZIP=1

# Anonymous agent access shares hosted allowances and controls. Opt in at deployment.
MCP_PUBLIC=off
PAID_ENDPOINT_PUBLIC=off

# Optional connection-panel override, e.g. a separately started local bearer MCP server.
# MCP_CONNECT_URL=http://127.0.0.1:PORT/mcp
