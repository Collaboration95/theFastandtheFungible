# Cloud Run appends its verified remote address to XFF. Select only the last hop;
# never forward a user-supplied prefix, and never append a second hop.
map $http_x_forwarded_for $visitor_ip {
  default $remote_addr;
  "~(?<last_ip>[0-9a-fA-F:.]+)$" $last_ip;
}
server {
  listen 8080;
  server_tokens off;
  access_log off;
  error_log /dev/stderr crit;
  client_max_body_size 16k;
  add_header Cache-Control no-store always;
  # Static bundles and JSON only; text/event-stream is never compressed (it would buffer SSE).
  gzip on;
  gzip_proxied any;
  gzip_types application/javascript text/css application/json image/svg+xml;
  # Proxy settings are shared by every proxied location below.
  proxy_http_version 1.1;
  proxy_pass_request_headers off;
  proxy_set_header Host $host;
  proxy_set_header Cookie $http_cookie;
  proxy_set_header Content-Type $http_content_type;
  proxy_set_header Accept $http_accept;
  proxy_set_header Origin $http_origin;
  proxy_set_header X-CSRF-Token $http_x_csrf_token;
  proxy_set_header Idempotency-Key $http_idempotency_key;
  proxy_set_header Last-Event-ID $http_last_event_id;
  proxy_set_header X-Forwarded-For $visitor_ip;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Connection "";
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_connect_timeout 5s;
  proxy_next_upstream off;
  proxy_intercept_errors on;
  error_page 502 504 =503 /paused.html;
  location = /livez { return 200 'alive'; }
  location = /startupz { return 200 'started'; }
  location = /paused.html { internal; root /usr/share/nginx/html; }
  # Cloud Run's edge reserves some paths ending in "z"; /ready is the public
  # readiness path for uptime checks and maps to the VM's /readyz.
  location = /ready {
    rewrite ^ /readyz break;
    proxy_pass http://${VM_UPSTREAM};
  }
  location / {
    proxy_pass http://${VM_UPSTREAM};
  }
}
