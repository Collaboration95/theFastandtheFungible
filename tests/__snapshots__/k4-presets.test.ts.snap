// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`'Account reserves' leads with its requested fact > XRPL3 1`] = `"The reserve documentation lists Mainnet settings of 1 XRP per account and 0.2 XRP per owned item at access time, and warns that other networks can differ."`;

exports[`'RLUSD escrow' leads with its requested fact > XRPL1 1`] = `"The team documented official RLUSD as blocked until its issuer enables AllowTrustLineLocking. The experimental issuer enables token locking before the buyer and writer establish eligible trust lines."`;

exports[`'x402 headers' leads with its requested fact > XRPL2 1`] = `"an HTTP 402 response offers payment requirements in PAYMENT-REQUIRED; the client chooses supported terms, authorizes payment and retries with PAYMENT-SIGNATURE. A successful HTTP response can include PAYMENT-RESPONSE with settlement details."`;
