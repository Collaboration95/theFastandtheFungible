// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`'Account reserves' leads with its requested fact > XRPL3 1`] = `"An XRPL wallet needs a base reserve of 1 XRP plus an owner reserve of 0.2 XRP for each object it owns, such as an escrow, offer or trust line, at current Mainnet settings."`;

exports[`'RLUSD escrow' leads with its requested fact > XRPL1 1`] = `"Not today: an XRPL escrow can hold official RLUSD only after its issuer enables AllowTrustLineLocking, and the RLUSD issuer had not enabled it on Mainnet or Testnet when the team checked on 11 November 2026."`;

exports[`'x402 payment' leads with its requested fact > XRPL2 1`] = `"an HTTP 402 response offers payment requirements in PAYMENT-REQUIRED; the client chooses supported terms, authorizes payment and retries with PAYMENT-SIGNATURE. An agent can pay a 402 in XRP on Testnet, network xrpl:1."`;
