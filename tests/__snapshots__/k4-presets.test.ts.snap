// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`'Account reserves' leads with its requested fact > XRPL3 1`] = `"The reserve documentation lists Mainnet settings of 1 XRP per account and 0.2 XRP per owned item at access time, and warns that other networks can differ."`;

exports[`'RLUSD escrow' leads with its requested fact > XRPL1 1`] = `"The team documented official RLUSD as blocked until its issuer enables AllowTrustLineLocking. A successful TEST-SGD escrow proves only that this configured stand-in worked on Testnet."`;

exports[`'x402 headers' leads with its requested fact > XRPL2 1`] = `"The x402 headers are PAYMENT-REQUIRED, which carries the challenge; PAYMENT-SIGNATURE carries the buyer payment proof; PAYMENT-RESPONSE carries settlement information. Its HTTP transport uses PAYMENT-REQUIRED for requirements and PAYMENT-SIGNATURE for authorization."`;
