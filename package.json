{
  "name": "research-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run demo",
    "dev:client": "vite --host 0.0.0.0 --port 5100 --strictPort",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "testing": "npm run test:unit && playwright test",
    "check:fast": "npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run lint && npm run typecheck && npm run testing && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare": "husky",
    "demo": "node scripts/demo.mjs",
    "demo:live": "node scripts/demo.mjs --live",
    "demo:reset": "node scripts/demo-reset.mjs",
    "dev:publisher": "tsx publisher/server.ts",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "eval:bank": "tsx eval/questions/bank.ts",
    "eval:decisions": "tsx eval/decisions/offline.ts",
    "eval:coverage": "tsx eval/coverage/run.ts",
    "eval:labels": "tsx scripts/export-decision-labels.ts",
    "calibration:fit": "tsx eval/decisions/fit-calibration.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@langfuse/client": "^5.13.0",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@orama/orama": "^3.1.18",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ripple-keypairs": "^2.1.0",
    "xrpl": "^4.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
