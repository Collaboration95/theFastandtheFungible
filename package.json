{
  "name": "research-agent",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "corpus:public-docs": "node scripts/build-public-docs.mjs",
    "dev": "npm run demo",
    "dev:client": "vite --port 5100 --strictPort",
    "dev:server": "tsx server/index.ts",
    "build": "tsc -b && vite build && node scripts/bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "testing": "npm run test:unit && playwright test",
    "readme:check": "node scripts/readme-scorecard.mjs --check && node scripts/readme-architecture.mjs --check && node scripts/install-snippets.mjs --tag v1.1.1 --check",
    "site:progress": "node scripts/build-progress-data.mjs",
    "facts": "node scripts/facts.mjs",
    "site:publish": "python3 scripts/site-publish.py",
    "check:release-urls": "node scripts/check-release-urls.mjs",
    "hygiene": "npm run check:naming && node scripts/repo-hygiene.mjs && node scripts/check-feedback-ids.mjs && node scripts/site-header.mjs --check && node scripts/render-progress.mjs --check && node scripts/facts.mjs --check",
    "release": "node scripts/release.mjs",
    "check:fast": "npm run hygiene && npm run check:paid-bodies && npm run lint && npm run typecheck && npm run test:unit && npm run chaos:smoke",
    "gate": "node scripts/local-gate.mjs",
    "verify": "npm run lint && npm run typecheck && npm run testing && npm run build",
    "preview": "vite preview",
    "prepare": "husky",
    "demo": "node scripts/demo.mjs",
    "demo:live": "node scripts/demo.mjs --live",
    "demo:reset": "node scripts/demo-reset.mjs",
    "dev:publisher": "tsx publisher/server.ts",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "eval:bank": "tsx eval/questions/bank.ts",
    "eval:decisions": "tsx eval/decisions/offline.ts",
    "eval:coverage": "tsx eval/coverage/run.ts",
    "eval:labels": "tsx scripts/export-decision-labels.ts",
    "calibration:fit": "tsx eval/decisions/fit-calibration.ts",
    "scorecard": "tsx eval/scorecard/run.ts",
    "gate:audit": "tsx scripts/gate-audit.ts",
    "audit:export": "tsx scripts/audit-export.ts",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "data:prune": "tsx scripts/data-prune.ts",
    "brand:build": "node design/brand/build-brand.mjs",
    "brand:verify": "node design/brand/verify.mjs",
    "check:naming": "node scripts/naming-audit.mjs",
    "publish:init": "node --import tsx scripts/publish-init.ts",
    "publish:site": "node --import tsx scripts/publish-site.ts",
    "calibration:refit": "tsx scripts/refit-receipt-value.ts",
    "agents": "tsx scripts/agents.ts",
    "verify:answer": "tsx scripts/verify-answer.ts",
    "chaos": "node scripts/chaos.mjs",
    "chaos:smoke": "npm run chaos -- --runs 20 --seed 279",
    "build:sdk": "node scripts/build-sdk.mjs",
    "test:sdk:package": "node scripts/check-sdk-package.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:demo": "vite build --config demo/vite.config.ts --mode browser-demo",
    "demo:capture": "tsx scripts/capture-browser-demo.ts",
    "test:demo": "npm run build:demo && playwright test --config tests/playwright/demo.config.ts",
    "test:judge": "npm run build:demo && playwright test --config tests/playwright/judge.config.ts",
    "check:paid-bodies": "node scripts/check-paid-bodies.mjs",
    "proof:model": "tsx scripts/proof/run-model.ts",
    "proof:sim": "node scripts/chaos.mjs --proof-sim",
    "proof:redteam": "vitest run tests/proof/redteam",
    "proof:testnet-run": "node --import tsx scripts/testnet-1000/run.mjs",
    "proof:testnet-verify": "node scripts/testnet-1000/verify.mjs",
    "proof:testnet-test": "node --import tsx --test scripts/testnet-1000/verify.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@langfuse/client": "^5.13.0",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@orama/orama": "^3.1.18",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ripple-keypairs": "^2.1.0",
    "ws": "^8.22.1",
    "xrpl": "^4.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "8.20.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fontkit": "2.0.4",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "qrcode-generator": "2.0.4",
    "smol-toml": "1.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "x402-xrpl": "0.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "productName": "ResearchAgent"
}
