      "start": 65.4,
      "end": 79.4,
      "words": 26,
      "sentences": [
        {
          "start": 65.4,
          "end": 69,
          "text": "Export the receipts and check them outside the app."
        },
        {
          "start": 69,
          "end": 72.2,
          "text": "Our TypeScript and Python verifiers were written separately."
        },
        {
          "start": 72.2,
          "end": 75.8,
          "text": "The receipts tie the cited passages to the payment."
        }
      ]
    },
    {
