    {
      "id": "s2-sandbox",
      "title": "Question, paywall, payment",
      "start": 9.4,
      "end": 36.4,
      "words": 57,
      "sentences": [
        {
          "start": 9.4,
          "end": 17.4,
          "text": "How does the writer get paid, and what stops the agent from reading the article and then refusing to pay?"
        },
        {
          "start": 17.4,
          "end": 18.599999999999998,
          "text": "Free sources first."
        },
        {
          "start": 18.599999999999998,
          "end": 21.799999999999997,
          "text": "Policy buys the missing passage within your budget."
        },
        {
          "start": 21.799999999999997,
          "end": 26.199999999999996,
          "text": "This run finished in 20.7 seconds and bought one S$0.40 article."
        },
        {
          "start": 26.199999999999996,
          "end": 32.199999999999996,
          "text": "The key that unlocks the article is the same key that releases the writer's payment."
        }
      ]
    },
    {
      "id": "s3-refund",
      "title": "Check the key",
      "start": 36.4,
      "end": 51.4,
      "words": 26,
      "sentences": [
        {
          "start": 36.4,
          "end": 39.6,
          "text": "The writer collects by publishing the article key."
        },
        {
          "start": 39.6,
          "end": 44.800000000000004,
          "text": "This browser reads both transactions from a public node and hashes the key."
        },
        {
          "start": 44.800000000000004,
          "end": 46.800000000000004,
          "text": "It matches the payment lock."
        }
      ]
    },
    {
      "id": "s3b-refusal",
      "title": "Verify the recorded proof",
      "start": 51.4,
      "end": 65.4,
      "words": 23,
      "sentences": [
        {
          "start": 51.4,
          "end": 54.6,
          "text": "Check the recorded proof without asking a question."
        },
        {
          "start": 54.6,
          "end": 60.6,
          "text": "The featured run shows all five gates held: twenty-four checks passed and two not checked."
        }
      ]
    },
    {
      "id": "s5-verify",
