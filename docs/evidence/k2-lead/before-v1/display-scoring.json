              "resourceId": "team-x402",
              "version": "v2",
              "spanId": "p1"
            }
          ]
        },
        {
          "text": "Every writer is a facilitator: the publisher host serves /w/:slug/..., and the buyer pays the writer's own wallet on XRPL Testnet (xrpl:1, scheme exact, asset XRP in integer drops).",
          "citations": [
            {
              "resourceId": "team-x402",
              "version": "v2",
              "spanId": "p3"
            }
          ]
        }
      ],
      "answersIt": 0
