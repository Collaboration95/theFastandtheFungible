# Operating-system and editor noise
.DS_Store
.codex/

# Scratch repositories and local-only research material
/scratch/

# Local dependency and build output
**/node_modules/
**/dist/

# Reference captures stay on disk for visual inspection but are not committed.
/website-template/*/*/images/*.png

# Prototype QA keeps only explicitly named final captures in Git.
/website-template/prototypes/qa/*/*.png
!/website-template/prototypes/qa/*/*-final.png

# Local environment files
.env
.env.*
!.env.example
