# Operating-system and editor noise
.DS_Store
.codex/

# Scratch repositories and local-only research material
/scratch/

# Local dependency and build output
**/node_modules/
**/dist/

# Reference captures stay on disk for visual inspection but are not committed.
/website-template/*/*/images/*.png

# Prototype QA keeps only explicitly named final captures in Git.
/website-template/prototypes/qa/*/*.png
!/website-template/prototypes/qa/*/*-final.png

# Local environment files
.env
.env.*
!.env.example

# ResearchAgent runtime output
data/runs.json
*.tsbuildinfo
test-results/
.playwright/

# Codex Excalidraw runtime metadata and transient validation exports
/canvas/excalidraw/session.json
/canvas/excalidraw/selection.json
/canvas/excalidraw/actions.json
/canvas/excalidraw/comments.json
/canvas/excalidraw/executor-*.json
/canvas/excalidraw/checkpoints/
/canvas/excalidraw/exports/native_batch_*.svg
/canvas/excalidraw/exports/visual_validation_*.svg
/canvas/excalidraw/exports/*-preview.png
/canvas/excalidraw/exports/*-preview.svg

# Standalone Codex Excalidraw projects keep only editable scenes and named exports.
/diagrams/**/canvas/excalidraw/session.json
/diagrams/**/canvas/excalidraw/selection.json
/diagrams/**/canvas/excalidraw/actions.json
/diagrams/**/canvas/excalidraw/comments.json
/diagrams/**/canvas/excalidraw/executor-*.json
/diagrams/**/canvas/excalidraw/checkpoints/
/diagrams/**/canvas/excalidraw/exports/native_batch_*.svg
/diagrams/**/canvas/excalidraw/exports/visual_validation_*.svg
